# Data files (too large and contains personal address data)
data/raw/
data/processed/

# Kaggle staging: zips and downloaded outputs used to move the 1M-record
# run on and off Kaggle, includes a 2GB model pickle, never belongs in git.
report/kaggle/

# Python
__pycache__/
*.pyc
*.pyo
.env
venv/
.venv/

# Jupyter checkpoints
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Report drafts (submit final via Blackboard)
report/*.docx
report/*.pdf

# Blackboard submission receipts: carry a real name and a confirmation
# number, personal records, not project files.
report/*receipt*.txt

# Session scratch, not a project deliverable: a personal submission
# checklist and a one-off side-draft tool from an earlier word-trimming
# pass, both superseded by the real report generator.
FINAL_CHECKLIST.md
report/REWRITE_DRAFT_COMPARE.md
report/_build_rewrite_draft.py

# Trained model binaries (too large for a normal git push, GitHub rejects
# anything over 100MB outright; the real Random Forest export is ~200MB.
# feature_schema.json is small and IS tracked, it's just data (column
# names/categories), not a binary.
report/model/*.onnx

# Browser demo: scaffolded but unfinished. MODEL_URL is still a literal
# placeholder ("REPLACE_WITH_GITHUB_RELEASE_ASSET_URL"), no ONNX model has
# been uploaded as a release asset, and it has never been deployed anywhere.
# Excluding it rather than shipping a page that visibly doesn't work; bring
# it back once the model is hosted and the URL is wired in for real.
web/

*.tmp
~$*
.~lock.*
